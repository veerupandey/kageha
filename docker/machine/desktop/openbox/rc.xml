<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Mouse</monitor>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name><size>10</size><weight>Bold</weight><slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant>
    </font>
    <font place="MenuHeader">
      <name>DejaVu Sans</name><size>10</size><weight>Bold</weight><slant>Normal</slant>
    </font>
    <font place="MenuItem">
      <name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant>
    </font>
    <font place="OnScreenDisplay">
      <name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant>
    </font>
  </theme>
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names><name>Desktop</name></names>
    <popupTime>0</popupTime>
  </desktops>
  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Nonpixel</popupShow>
  </resize>
  <margins>
    <top>0</top>
    <bottom>34</bottom>
    <left>0</left>
    <right>0</right>
  </margins>
  <dock>
    <position>TopLeft</position>
    <stacking>Above</stacking>
    <noStrut>no</noStrut>
  </dock>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="A-Escape"><action name="Lower"/></keybind>
    <keybind key="A-space"><action name="ShowMenu"><menu>client-menu</menu></action></keybind>
    <keybind key="A-Tab"><action name="NextWindow"><dialog>list</dialog><bar>no</bar></action></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"><dialog>list</dialog><bar>no</bar></action></keybind>
    <keybind key="W-t"><action name="Execute"><command>kageha-term</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>pcmanfm /work</command></action></keybind>
    <keybind key="W-b"><action name="Execute"><command>kageha-browser</command></action></keybind>
  </keyboard>
  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>300</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>
    <context name="Frame">
      <mousebind button="A-Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="TitlebarLeft" />
    <context name="Desktop">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Unfocus"/></mousebind>
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    </context>
    <context name="Close"><mousebind button="Left" action="Click"><action name="Close"/></mousebind></context>
    <context name="Maximize"><mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind></context>
    <context name="Iconify"><mousebind button="Left" action="Click"><action name="Iconify"/></mousebind></context>
  </mouse>
  <menu>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
    <middle>no</middle>
    <submenuShowDelay>100</submenuShowDelay>
    <applicationIcons>yes</applicationIcons>
  </menu>
  <applications>
    <application class="Chromium*">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <position force="yes"><x>0</x><y>0</y><monitor>1</monitor></position>
    </application>
    <application class="chromium*">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <position force="yes"><x>0</x><y>0</y><monitor>1</monitor></position>
    </application>
    <application name="xterm" class="XTerm">
      <decor>yes</decor>
      <position force="yes"><x>36</x><y>430</y><monitor>1</monitor></position>
    </application>
  </applications>
</openbox_config>
