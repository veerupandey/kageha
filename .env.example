# Copy to .env and fill values. Never commit .env.

GEMINI_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
FAL_KEY=
# FAL_API_KEY=                 # alias accepted by setup / media pack
# KAGEHA_FAL_IMAGE_MODEL=flux-schnell   # default for fal_generate_image (flux|flux-schnell)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=             # OpenCode Go $10/mo — https://opencode.ai/zen/go
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
CMD_API_KEY=                  # Command Code Provider API — https://commandcode.ai/docs/provider

# Cloudflare Workers AI (provider "cloudflare" in models.yaml — chat models
# cf-glm-5.3, cf-glm-5.3-flash, cf-deepseek-v4-flash/pro, cf-qwen-3.8).
# Both are required: the account id is interpolated into the base_url.
CLOUDFLARE_API_TOKEN=          # https://dash.cloudflare.com/profile/api-tokens (Workers AI)
CLOUDFLARE_ACCOUNT_ID=         # dashboard URL segment, e.g. a77c44ab5df968b4f3c6960a7e72fedd
# Media (image/tts/stt) providers below reuse these same credentials.

# Azure OpenAI (openai_compat provider "azure" in models.yaml)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# KAGEHA_EMBEDDING_PROVIDER=azure
# KAGEHA_EMBEDDING_MODEL=text-embedding-3-large
# KAGEHA_EMBEDDING_DIMENSIONS=3072

# Optional: web_search + vision hop (anyone can pin any provider)
# Order: first available in KAGEHA_WEB_SEARCH_ORDER / ~/.kageha/search.yaml
# Default auto order: Z.AI → Brave → Tavily → Exa → Perplexity → Gemini → DuckDuckGo
# BRAVE_API_KEY=            # https://api-dashboard.search.brave.com/
# TAVILY_API_KEY=           # https://app.tavily.com/
# EXA_API_KEY=              # https://dashboard.exa.ai/
# PERPLEXITY_API_KEY=       # https://www.perplexity.ai/settings/api
# ZAI_API_KEY=              # also unlocks Z.AI Web Search Prime and Coding Plan chat
# KAGEHA_WEB_SEARCH=auto    # auto|zai|brave|tavily|exa|perplexity|gemini|ddg|gemini_only
# KAGEHA_WEB_SEARCH_ORDER=tavily,exa,perplexity,gemini,ddg
# KAGEHA_VISION_HOP=auto    # auto|gemini_analyze|native
# KAGEHA_BRAVE_COUNT=8
# KAGEHA_TAVILY_COUNT=8
# KAGEHA_TAVILY_DEPTH=basic
# KAGEHA_PERPLEXITY_COUNT=8
# KAGEHA_EXA_COUNT=8
# ~/.kageha/search.yaml is the same config, editable from Settings → Search.
#
# Blink research backend (core pack: research_run / parallel_web_fetch / headless_fetch)
# KAGEHA_RESEARCH_DEPTH=flash          # flash|standard|deep
# KAGEHA_RESEARCH_MAX_URLS=5
# KAGEHA_RESEARCH_MAX_QUERIES=4
# KAGEHA_RESEARCH_SOURCE_TIMEOUT=20   # seconds per search/page; allowed 1–120
# KAGEHA_RESEARCH_CACHE_TTL=600        # seconds; 0 disables
# KAGEHA_HEADLESS_BACKEND=auto         # auto|http|chromium|lightpanda|cdp
# KAGEHA_HEADLESS_CDP=http://127.0.0.1:9222   # Lightpanda: `lightpanda serve --port 9222`
# KAGEHA_HEADLESS_MAX_PAGES=4


# Optional channels
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs. Empty means deny all users.
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_ALLOW_ALL_USERS=1  # development only
# WhatsApp QR / Baileys (experimental)
# WHATSAPP_QR_ALLOWED_USERS=
# WHATSAPP_QR_ALLOW_ALL_USERS=1  # development only
# KAGEHA_WA_AUTH_DIR=~/.kageha/platforms/whatsapp/session
# WHATSAPP_QR_ENABLED=1

# Phone calls (Twilio) — inbound + outbound voice. Enable tools with
# KAGEHA_TOOL_PACKS=telephony. Configure via `kageha channels setup`.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+14155552671        # your Twilio number, E.164
# Deny-by-default: only these numbers reach the agent on INBOUND calls.
# PHONE_ALLOWED_NUMBERS=+14155559999     # comma-separated E.164; * only for testing
# PHONE_ALLOW_ALL_CALLERS=1              # development only
# Public HTTPS+wss URL Twilio can reach. Inbound + live audio REQUIRE this.
# Laptop: `ngrok http 8788` or `cloudflared tunnel --url http://localhost:8788`.
# Server: open the port and use its public https URL. Point the Twilio number's
# Voice webhook at <PUBLIC_BASE_URL>/webhook/phone.
# PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# PHONE_MAX_CALL_SECONDS=600             # hard duration ceiling
# PHONE_RECORD_CALLS=0                   # 1 to record (check consent/laws)
# PHONE_AI_DISCLOSURE=Hello, this is an automated assistant calling on behalf of my user.
# Voice quality follows configured TTS/STT (Gemini/Cloudflare/OpenAI/ElevenLabs).
# KAGEHA_TTS_PCM_RATE=24000              # raw PCM rate assumed for TTS output

# OAuth connections (kageha connect list|login|status|logout|credentials)
# GitHub OAuth App with Device Flow enabled
# GITHUB_OAUTH_CLIENT_ID=
# Optional allowlist (default: gmail,gcal,gdrive,github)
# KAGEHA_CONNECTIONS_ALLOWLIST=gmail,github
# Gmail OAuth client (used by `kageha connect login gmail`)
# GOOGLE_OAUTH_CLIENT_JSON=~/.kageha/connections/google-client.json
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

KAGEHA_HOME=~/.kageha
KAGEHA_SKILLS_PATH=
# Optional: colon-separated custom tool pack dirs (also ~/.kageha/tools/)
# KAGEHA_TOOLS_PATH=
# Optional: import host-editor MCP configs (Claude Desktop / mcp.json)
# KAGEHA_MCP_IMPORT_HOST=1
# Mode defaults: Normal 128, Plan 256, Goal 512. Optional global override:
# KAGEHA_MAX_STEPS=512
# Optional hard spending limit. Default 0 tracks cost without interrupting work.
KAGEHA_MAX_USD=0
# Total startup planning time, including provider routing and plan repair.
# If exceeded, execution continues from the objective with completion checks intact.
# KAGEHA_PLANNING_TIMEOUT_S=30
# Routine shell network, helper tools, and desktop input in agent environments.
# Local/macOS behavior is unchanged. Set either to 0 to retain approval prompts.
KAGEHA_SERVER_AUTONOMY=1
KAGEHA_MACHINE_AUTONOMY=1
# Max output tokens per model reply. Default is provider-sized per effort tier
# (low 8192 / medium 16384 / high 32768). Set a single cap for all tiers:
# KAGEHA_MAX_OUTPUT_TOKENS=16384
# GLM (Z.AI) output cap. Default: no cap from our side — the requested budget
# reaches the provider so long answers are not trimmed mid-sentence. Opt in to
# constrain GLM for latency/cost: a number caps it; the literal `effort`
# restores the legacy per-effort caps (low 2048 / medium 4096 / high 6144).
# KAGEHA_GLM_MAX_TOKENS=8192
# KAGEHA_GLM_MAX_TOKENS=effort

# Default: run shell when OS isolation isn't available; risky tools still HITL.
# Use `strict` only when seatbelt/bwrap/docker is present — otherwise bash is
# denied and the agent can't run code / build binary deliverables.
KAGEHA_SECURITY_PROFILE=approval_fallback
# Optional OpenTelemetry HTTP endpoint. Local metrics/traces are always retained.
# KAGEHA_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Long-lived `kageha chat`, `kageha webui`, and `kageha server` commands start
# the channels worker when a Telegram token or WHATSAPP_QR_ENABLED is set.

# Shell OS sandbox: auto | seatbelt | bwrap | docker | ssh | off
# Writes are confined to the coding root. TMPDIR/TMP/TEMP are forced into the
# in-root .kageha-tmp scratch dir, and uv/pip caches (UV_CACHE_DIR,
# PIP_CACHE_DIR, XDG_CACHE_HOME/XDG_DATA_HOME) are redirected there too so
# `uv pip install` / `mktemp` work without host-temp write grants. The fixed
# per-user Darwin temp dir is granted on macOS only so BSD `mktemp` (which
# ignores $TMPDIR) works. Credential dirs (~/.ssh, ~/.aws, …) stay read-only.
# KAGEHA_SANDBOX=auto
# KAGEHA_SANDBOX_WORKSPACE_ACCESS=rw
# KAGEHA_SANDBOX_READ_ONLY_ROOT=1
# KAGEHA_SANDBOX_DOCKER_IMAGE=python:3.12-slim
# KAGEHA_SANDBOX_DOCKER_BINDS=
# KAGEHA_SANDBOX_SSH_HOST=
# KAGEHA_SANDBOX_SSH_USER=
# KAGEHA_SANDBOX_SSH_PORT=22
# KAGEHA_SANDBOX_SSH_IDENTITY=
# KAGEHA_SANDBOX_SSH_WORKDIR=/tmp/kageha-work

# Remote execution environment (opt-in): run ALL shell + file effects on a
# remote SSH host while the control plane (model, planning, UI) stays local.
# See docs/REMOTE_EXECUTION.md. Requires key-based, non-interactive SSH.
# KAGEHA_EXECUTION_ENV=remote        # or `ssh`; makes the session REMOTE
# KAGEHA_REMOTE_HOST=box.example.com
# KAGEHA_REMOTE_USER=ubuntu
# KAGEHA_REMOTE_PORT=22
# KAGEHA_REMOTE_IDENTITY=~/.ssh/id_ed25519
# KAGEHA_REMOTE_WORKDIR=~/.kageha/work   # per-session subdir is appended
# KAGEHA_REMOTE_INIT=                    # optional one-time setup run in the workdir

# Browser: headless | comet | docker
# KAGEHA_BROWSER_MODE=headless
# KAGEHA_BROWSER_DOCKER_IMAGE=browserless/chrome:latest

# Curator schedule interval for `kageha daemon` (7d / 24h / seconds)
# KAGEHA_CURATOR_CRON=7d


# Browser defaults to Kageha's Lightpanda CDP when available, then Chromium.
# Use `/browser use comet` or `/browser use chrome` for an explicit visible/
# logged-in browser (persists ~/.kageha/browser.json + enables the browser pack).
# KAGEHA_BROWSER_MODE=cdp
# KAGEHA_COMET_CDP=http://127.0.0.1:9222
# KAGEHA_BROWSER_PACK=1          # force-enable optional browser tools
# KAGEHA_COMET_PROFILE=~/Library/Application Support/Comet

# Android / Google TV via adb — skill: android_tv (skill_run scripts; not a tool pack)
# Install platform-tools; enable Network debugging on the TV; accept RSA prompt.
# KAGEHA_ANDROID_TV_HOST=192.168.1.50
# KAGEHA_ANDROID_TV_PORT=5555
# KAGEHA_ANDROID_TV_SERIAL=192.168.1.50:5555

# Sony Bravia IP control (PIN cookie pairing or PSK) — skill: sony_bravia
#   uv run kageha bravia discover
#   uv run kageha bravia pair
# KAGEHA_BRAVIA_HOST=10.0.0.14
# KAGEHA_BRAVIA_PSK=

# Optional native tool packs (default core: forge,skills,mcp,memory,subagent,research)
# KAGEHA_TOOL_PACKS=browser,media
# KAGEHA_TOOL_PACKS=all



# Provenance-aware memory (SQLite/FTS5 authority; vectors are optional derivatives)
KAGEHA_MEMORY_ENABLED=1
KAGEHA_MEMORY_LEARN=1
KAGEHA_MEMORY_MIN_SCORE=0.45
KAGEHA_MEMORY_MAX_RESULTS=6
# auto = enable zvec memory whenever an embedding model/key is defined; else FTS-only
KAGEHA_MEMORY_EMBEDDINGS=auto
KAGEHA_MEMORY_MODEL_ROLE=fast_worker
# LLM extract on verified successful turns (auto|on|off); regex always remains
KAGEHA_MEMORY_LLM_EXTRACT=auto
KAGEHA_MEMORY_LLM_EXTRACT_TIMEOUT=8
# Consolidate/dream cooldown hours (0 = every idle pass)
KAGEHA_MEMORY_CONSOLIDATE_HOURS=6
# Hash-gated AGENTS.md/CLAUDE.md/.cursor/rules sync on turn start (auto|on|off)
KAGEHA_MEMORY_AUTO_SYNC_RULES=auto
# Optional LLM dream during consolidate (off|auto|on); SQLite stays authority
KAGEHA_MEMORY_LLM_DREAM=off
KAGEHA_MEMORY_LLM_DREAM_TIMEOUT=12
# KAGEHA_MEMORY_EMBEDDINGS=off
# KAGEHA_MEMORY_EMBEDDINGS=zvec
# KAGEHA_MEMORY_EMBEDDINGS=vgrag

# Embedding model (also gates memory semantic accelerator when EMBEDDINGS=auto)
# KAGEHA_EMBEDDING_PROVIDER=gemini
# KAGEHA_EMBEDDING_MODEL=gemini-embedding-001
# KAGEHA_EMBEDDING_DIMENSIONS=768
# KAGEHA_SKILL_EMBEDDINGS=auto   # auto | off | force
# Minimum combined match score before L2 skill body autoload (default 3)
# KAGEHA_SKILL_AUTOLOAD_MIN=3
# Rebuild cache: uv run kageha skills reindex
# Rebuild memory vectors: uv run kageha memory reindex

# Gemini TTS (tool: gemini_tts) — provider must be gemini
# Opt-in durable agents/media (see docs/DURABLE_JOBS.md).
# KAGEHA_DURABLE_JOBS=1
# KAGEHA_JOB_AUTOSTART=1
# KAGEHA_JOB_AGENTS=4
# Reservation estimates, not provider prices:
# KAGEHA_WORKER_BUDGET_USD=0.25
# KAGEHA_TTS_JOB_RESERVATION_USD=0.05
# KAGEHA_VOICE_PROVIDER=gemini
# KAGEHA_VOICE_MODEL=gemini-3.1-flash-tts-preview
# KAGEHA_VOICE_NAME=Kore
